// Copy to Config/LocalSecrets.xcconfig for local development or archive builds.
// This file is intentionally tracked as a template; the real LocalSecrets.xcconfig is ignored.
CMDREOPEN_REVENUECAT_API_KEY = appl_your_public_revenuecat_sdk_key
CMDREOPEN_POSTHOG_PROJECT_TOKEN = phc_your_project_token
# Leave the default US ingestion host unless the mac-app project is created in another region.
CMDREOPEN_POSTHOG_HOST = https:/$()/us.i.posthog.com
