          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’app a amélioré votre utilisation de Cmd+Tab, un avis sur l’App Store aidera d’autres utilisateurs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Command ReopenでCmd+Tabが使いやすくなったなら、App Storeでの短いレビューが他のユーザーの助けになります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
