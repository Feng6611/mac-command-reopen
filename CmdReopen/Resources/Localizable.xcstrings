    "Purchase completed, but Pro access is still syncing. Please wait a moment or use Restore Purchase." : {
      "comment" : "Purchase-sync error; 'Restore Purchase' is a button title and must match its translation.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kauf abgeschlossen, aber der Pro-Zugang wird noch synchronisiert. Bitte warte einen Moment oder verwende „Kauf wiederherstellen“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achat effectué, mais l’accès Pro est encore en cours de synchronisation. Patientez un instant ou utilisez « Restaurer l’achat »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入は完了しましたが、Proアクセスはまだ同期中です。しばらくお待ちいただくか、「購入を復元」をご利用ください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "购买已完成，但 Pro 权限仍在同步。请稍候，或点按“恢复购买”。"
          }
        }
      }
    },
    "Purchase options are unavailable right now. Try again later or restore an existing purchase." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaufoptionen sind derzeit nicht verfügbar. Versuche es später erneut oder stelle einen bestehenden Kauf wieder her."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les options d’achat sont indisponibles pour le moment. Réessayez plus tard ou restaurez un achat existant."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入オプションは現在利用できません。後でもう一度お試しいただくか、既存の購入を復元してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂时无法获取购买选项。请稍后再试，或恢复已有的购买。"
          }
        }
      }
    },
