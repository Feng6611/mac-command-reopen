    },
    "Purchases are turned off on this Mac. Check your Screen Time content and privacy restrictions." : {
      "comment" : "Purchase error when StoreKit reports payments are not allowed; on macOS this is a Screen Time restriction. Use the platform's own name for that setting.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käufe sind auf diesem Mac deaktiviert. Prüfe die Inhalts- und Datenschutzbeschränkungen in der Bildschirmzeit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les achats sont désactivés sur ce Mac. Vérifiez les restrictions de contenu et de confidentialité dans Temps d’écran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacでは購入が許可されていません。スクリーンタイムのコンテンツとプライバシーの制限を確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 已关闭购买功能。请检查“屏幕使用时间”中的内容和隐私访问限制。"
          }
        }
      }
    },
    "Purchases aren’t available in this build. Please contact support." : {
      "comment" : "Purchase error the user cannot fix: the app's commerce configuration is missing or rejected. Do not name the commerce vendor.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käufe sind in dieser Version nicht verfügbar. Bitte wende dich an den Support."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les achats ne sont pas disponibles dans cette version. Veuillez contacter l’assistance."
          }
        },
        "ja" : {
