    "Choose System to follow macOS. Restart Command Reopen to apply the change." : {
      "comment" : "Settings › Language footer explaining the System option and the restart requirement.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie „System“, um der macOS-Sprache zu folgen. Starten Sie Command Reopen neu, damit die Änderung wirksam wird."
