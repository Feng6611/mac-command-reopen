    "After the last window closes or minimizes, bring the previous app forward so one Cmd+Tab returns here." : {
      "comment" : "Footer explaining automatic Cmd+Tab ordering after the foreground app loses its last visible window.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn das letzte Fenster geschlossen oder minimiert wird, kommt die vorherige App nach vorn, damit ein Cmd+Tab hierher zurückführt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après la fermeture ou la réduction de la dernière fenêtre, l’app précédente passe au premier plan afin qu’un seul Cmd+Tab vous ramène ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後のウインドウを閉じるか最小化すると前のアプリを前面にし、Cmd+Tab 1回でここに戻れるようにします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭或最小化最后一个窗口后，将上一个 App 切到前台，让你按一次 Cmd+Tab 就能返回。"
          }
        }
      }
    },
