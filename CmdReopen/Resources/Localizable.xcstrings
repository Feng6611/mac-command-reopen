    "Open source under MIT. Command Reopen needs no system permissions — and you can check that in the source rather than take our word for it." : {
      "comment" : "About-pane footer tying the zero-permission claim to the public source.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Source unter MIT-Lizenz. Command Reopen benötigt keine Systemberechtigungen — und du musst uns das nicht glauben, sondern kannst es im Quellcode nachprüfen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open source sous licence MIT. Command Reopen ne demande aucune autorisation système — et vous pouvez le vérifier dans le code plutôt que nous croire sur parole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MITライセンスのオープンソースです。Command Reopenはシステム権限を一切必要としません。その点はソースコードでご確認いただけます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 MIT 协议开源。Command Reopen 不需要任何系统权限——你可以在源代码里自己核实，不必只听我们说。"
          }
        }
      }
    },
