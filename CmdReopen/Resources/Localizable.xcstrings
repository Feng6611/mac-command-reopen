    "The App Store did not finish syncing this purchase yet. Please try again in a moment or use Restore Purchase." : {
      "comment" : "Purchase-sync error; 'Restore Purchase' is a button title and must match its translation.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der App Store hat diesen Kauf noch nicht vollständig synchronisiert. Bitte versuchen Sie es gleich erneut oder verwenden Sie „Kauf wiederherstellen“."
