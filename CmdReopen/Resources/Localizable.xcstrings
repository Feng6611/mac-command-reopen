    "Open source under MIT. Command Reopen needs no system permissions — and you can check that in the source rather than take our word for it." : {
      "comment" : "About-pane footer tying the zero-permission claim to the public source.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Source unter MIT-Lizenz. Command Reopen benötigt keine Systemberechtigungen — und Sie müssen uns das nicht glauben, sondern können es im Quellcode nachprüfen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open source sous licence MIT. Command Reopen ne demande aucune autorisation système — et vous pouvez le vérifier dans le code plutôt que nous croire sur parole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIT ライセンスのオープンソースです。Command Reopen はシステム権限を一切必要としません。その点はソースコードでご確認いただけます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
